# Copie para .env se quiser mudar algo (opcional).
TZ=America/Sao_Paulo
# UID do seu usuário no host, para os arquivos em stack/data/ e stack/dbt/ ficarem com você como dono.
AIRFLOW_UID=1000
AIRFLOW_PORT=8080
# Segredo dos tokens da API do Airflow. Valor padrão serve só para estudo local.
AIRFLOW_JWT_SECRET=somente-para-estudo-local-troque-em-producao
# Opcional: só para o parâmetro brain=claude. Deixe vazio para a demo determinística.
ANTHROPIC_API_KEY=
# Opcional: outro modelo para brain=claude. Vazio = padrão definido em src/agentready/agent.py.
AGENTREADY_MODEL=
MARQUEZ_WEB_PORT=3000
REPORT_PORT=8090
# Fase 3: interface do Phoenix (traces do pipeline e do agente).
PHOENIX_PORT=6006
# Fase 4: fontes simuladas (APIs da Aurora); /docs mostra as APIs. Só em 127.0.0.1.
UPSTREAM_PORT=8000
