# Copie para .env (que o git ignora) e preencha só o que for usar:
#   cp .env.example .env && chmod 600 .env
# Carregue com: uv run --env-file .env agentready ...   (ou: export UV_ENV_FILE=.env)
# Nunca abra este arquivo com a tela compartilhada.

# Cérebro Claude (--brain claude). Use uma chave só para o workshop, com limite de gasto.
ANTHROPIC_API_KEY=

# Cérebro local (--brain local): Ollama em 11434 ou llama.cpp em 8081.
AGENTREADY_LLM_MODEL=qwen2.5:14b
AGENTREADY_LLM_BASE_URL=http://localhost:11434/v1
# AGENTREADY_LLM_API_KEY=        # só se o llama.cpp foi iniciado com --api-key
